# Evidence photos are served only through evidence.php, which checks who is
# asking. Nothing in this folder is reachable directly.
Require all denied

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Belt and braces: even if the rules above were lost, never run PHP here.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
